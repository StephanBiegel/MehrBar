<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Q6 icon spike (phase 1, outside MehrBar.sln): 256-px shell icons with clean alpha for every item type
    the bar must show, plus latency and threading. UseWPF is only for BitmapSource / FormatConvertedBitmap /
    PngBitmapEncoder; no window is ever shown. The CsWin32 name list is project-local (NativeMethods.txt).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MehrBar.Spikes.Icons</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\Common\NativeMethods.json" />
    <Compile Include="..\Common\RepoPaths.cs" Link="Common\RepoPaths.cs" />
    <Compile Include="..\Common\Stats.cs" Link="Common\Stats.cs" />
  </ItemGroup>

</Project>
